# Server-only secrets. Never prefix these with NEXT_PUBLIC_.
NOTION_TOKEN=
NOTION_VERSION=2022-06-28
NOTION_DB_INGRESOS=
NOTION_DB_GASTOS=
NOTION_PAGE_PRESUPUESTO=

# Auth.js / Google OAuth
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=replace-with-a-long-random-secret
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# PostgreSQL used by Prisma for users, sessions, settings, and error logs.
DATABASE_URL=postgresql://user:password@host:5432/savings?sslmode=require

# Demo data is useful for previews only. Set false in production after Notion is configured.
ALLOW_DEMO_DATA=true

# Comma-separated emails that receive ADMIN role on first Google sign-in.
ADMIN_EMAILS=admin@example.com
